{
  "categories": [
    {
      "title": "## Features",
      "labels": ["feat"]
    },
    {
      "title": "## Bug Fixes",
      "labels": ["fix"]
    },
    {
      "title": "## Refactoring",
      "labels": ["refactor"]
    },
    {
      "title": "## Documentation",
      "labels": ["docs"]
    },
    {
      "title": "## Maintenance",
      "labels": ["chore", "build", "ci", "test"]
    }
  ],
  "ignore_labels": ["ignore", "dependabot"],
  "label_extractor": [
    {
      "pattern": "^(feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert)",
      "target": "$1",
      "flags": "gu"
    },
    {
      "pattern": ".*dependabot.*",
      "target": "ignore",
      "flags": "gu"
    },
    {
      "pattern": "^Merge (pull request|branch).*",
      "target": "ignore",
      "flags": "gu"
    }
  ],
  "template": "${{CHANGELOG}}\n\n<details>\n<summary>Uncategorized</summary>\n\n${{UNCATEGORIZED}}\n</details>",
  "commit_template": "- ${{TITLE}}"
}
